// B3Hub Construction Marketplace Platform - Prisma Schema
// After ANY change to this file run: npm run prisma:generate
// (that also regenerates .github/instructions/backend-schema.instructions.md)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ================================
// ENUMS
// ================================

enum UserType {
  BUYER // Demand side — anyone who orders materials or waste collection
  ADMIN // Platform administrators
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum CompanyType {
  CONSTRUCTION     // Construction company
  SUPPLIER         // Material supplier
  RECYCLER         // Waste management
  CARRIER          // Transport company
  HYBRID           // Recycler + Supplier (e.g. B3 Recycling — processes waste AND sells RC materials)
  RENTAL_PROVIDER  // Equipment rental company (scaffolding, generators, tools, etc.)
}

enum CompanyFeature {
  CONSTRUCTION_MANAGEMENT // Project management, budgets, DPRs, estimating (B3 Construction SaaS)
  RECYCLING_MANAGEMENT // Facility intake, APUS submissions, waste certificates (B3 Recycling SaaS)
}

enum CompanyRole {
  OWNER // Company admin — manages team, settings, billing
  MANAGER // Can manage jobs, orders, and assign drivers
  DRIVER // Can only see and execute transport jobs
  MEMBER // Default — read-only access
}

enum MaterialCategory {
  SAND
  GRAVEL
  STONE
  CONCRETE
  SOIL
  RECYCLED_CONCRETE
  RECYCLED_SOIL
  ASPHALT
  CLAY
  OTHER
}

enum MaterialUnit {
  TONNE
  M3
  PIECE
  LOAD
}

enum ContainerType {
  SKIP // Open top container
  ROLL_OFF // Roll-off dumpster
  COMPACTOR // Compactor container
  ENCLOSED // Enclosed container
}

enum ContainerSize {
  SMALL_3M3
  MEDIUM_5M3
  LARGE_7M3
  XLARGE_10M3
  XXLARGE_15M3
  XXXLARGE_20M3
}

enum ContainerStatus {
  AVAILABLE
  RENTED
  IN_TRANSIT
  MAINTENANCE
  RETIRED
}

enum OrderType {
  MATERIAL // Material purchase
  CONTAINER // Container rental
  DISPOSAL // Waste disposal
  TRANSPORT // Transport only
  COMBINED // Multiple services
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED // Funds held
  CAPTURED // Funds taken (on job start)
  RELEASED // Funds transferred to seller (on completion)
  PAID // Legacy/Direct
  PARTIALLY_PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CARD    // Card payment via Paysera Checkout
  INVOICE // NET terms — buyer pays via bank transfer or Paysera payment link
  SEPA    // SEPA Direct Debit via Paysera (for approved B2B buyers)
}

enum WastePurpose {
  CONSTRUCTION_WASTE
  DEMOLITION_WASTE
  EXCAVATION_SOIL
  MIXED_WASTE
  RECYCLABLE_MATERIALS
  HAZARDOUS_WASTE
  GREEN_WASTE
  OTHER
}

enum ApusStatus {
  NOT_REQUIRED  // non-licensed field or waste type outside APUS scope
  PENDING       // awaiting submission to VVD APUS
  SUBMITTED     // submitted to VVD APUS, awaiting acceptance
  ACCEPTED      // VVD confirmed the movement
  REJECTED      // VVD rejected — see apusNote
}

enum WasteType {
  CONCRETE          // demolition concrete, rubble
  BRICK             // bricks, masonry
  WOOD              // formwork, pallets, structural timber
  METAL             // rebar, steel, scrap metal
  PLASTIC           // pipes, sheeting, containers
  SOIL              // excavation soil, clay-free fill
  MIXED             // unsorted mixed construction waste
  HAZARDOUS         // asbestos, chemical residues, contaminated soil
  ASPHALT           // road surface milling, asphalt demolition
  GREEN_WASTE       // vegetation, stumps, site clearing biomass
  WEEE              // waste electrical & electronic equipment from site
  OIL_WASTE         // spent lubricants, hydraulic fluids, fuel residues
  TIRES             // vehicle/machinery tyres
  PACKAGING_WASTE   // big bags, stretch film, pallet wrap, cardboard
}

enum WasteProcessingStage {
  RECEIVED    // logged on arrival, not yet sorted
  SORTED      // visually classified, separated by type
  PROCESSING  // crusher / screener running on this batch
  PROCESSED   // output weight + recyclingRate set, ready to list
  LISTED      // producedMaterialId set — marketplace listing created
  REJECTED    // contaminated or otherwise unusable, diverted to landfill
}

enum RcGrade {
  RC_A  // clean, single-type source (e.g. demolition concrete, no steel)
  RC_B  // mixed but acceptable — standard recycled aggregate
  RC_C  // lower grade — fines, mixed demolition, suitable for fill/sub-base only
  UNGRADED // grade not yet assessed
}

// ── Rental services ────────────────────────────────────────────────────────
enum RentalServiceType {
  SCAFFOLDING     // Temporary scaffolding structures
  TEMP_FENCING    // Hoarding, crowd barriers, site security fencing
  SITE_OFFICE     // Mobile welfare / office cabins
  GENERATOR       // Power generator units
  LIGHTING_TOWER  // Site lighting towers for night work
  WATER_BOWSER    // Water supply tankers for remote sites
  // ── Construction equipment rental ──────────────────────────────────────────
  MINI_EXCAVATOR    // Mini excavators (up to 6t) for landscaping, utilities
  EXCAVATOR         // Full-size excavators (6t+)
  DUMPER            // Site dumper trucks
  COMPACTOR         // Plate compactors and rollers
  TELEHANDLER       // Telescopic handlers / forklifts
  AERIAL_PLATFORM   // Scissor lifts, cherry pickers
  AIR_COMPRESSOR    // Air compressors & pneumatic tools
  POWER_TOOLS       // Hand-held power tools (drills, grinders, etc.)
  WELDER            // Welding machines & accessories
  HEATER            // Space heaters for site use
  CONCRETE_EQUIPMENT // Concrete mixers, vibrators, screeds, power floats
  REBAR_EQUIPMENT   // Rebar bending and cutting machines
  ALUMINUM_TOWER    // Aluminium access towers & ladders
}

enum RentalOrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  IN_USE
  COLLECTED
  COMPLETED
  CANCELLED
}

enum ContainerOrderStatus {
  SCHEDULED
  DELIVERED
  IN_USE
  PICKED_UP
  COMPLETED
  CANCELLED
}

enum TransportJobType {
  MATERIAL_DELIVERY
  CONTAINER_DELIVERY
  CONTAINER_PICKUP
  WASTE_COLLECTION
  EQUIPMENT_TRANSPORT
  TRANSPORT // General point-to-point freight transport
  HOTSHOT   // On-demand parts/tools delivery — small vehicles, fast dispatch
}

enum TransportJobStatus {
  AVAILABLE // Available for assignment
  ASSIGNED // Assigned to carrier
  ACCEPTED // Accepted by driver
  EN_ROUTE_PICKUP // On the way to pickup
  AT_PICKUP // At pickup location
  LOADED // Cargo loaded
  EN_ROUTE_DELIVERY // On the way to delivery
  AT_DELIVERY // At delivery location
  DELIVERED // Completed
  CANCELLED // Cancelled
  DELIVERY_REFUSED // Buyer/site refused to accept delivery at the door
}

enum TransportExceptionType {
  DRIVER_NO_SHOW
  SUPPLIER_NOT_READY
  WRONG_MATERIAL
  PARTIAL_DELIVERY
  REJECTED_DELIVERY
  SITE_CLOSED
  OVERWEIGHT
  OTHER
}

enum TransportExceptionStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum VehicleType {
  DUMP_TRUCK_10T
  DUMP_TRUCK_18T
  DUMP_TRUCK_26T
  FLATBED_TRUCK
  SEMI_TRAILER
  SKIP_LOADER
  TANKER
}

enum VehicleStatus {
  ACTIVE
  IN_USE
  MAINTENANCE
  INACTIVE
}

enum NotificationType {
  ORDER_CREATED
  ORDER_CONFIRMED
  ORDER_CANCELLED
  ORDER_DELIVERED
  TRANSPORT_ASSIGNED
  TRANSPORT_STARTED
  TRANSPORT_COMPLETED
  TRANSPORT_ARRIVAL_SCHEDULED // driver committed to an ETA window; buyer is notified
  PAYMENT_RECEIVED
  QUOTE_RECEIVED
  QUOTE_ACCEPTED
  SYSTEM_ALERT
  DOCUMENT_EXPIRING_SOON
  DRIVER_NEARBY
  WEIGHING_SLIP
  PAYOUT_PENDING         // carrier needs to provide IBAN for payouts
}

enum FrameworkContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum FieldPassStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum FrameworkPositionType {
  MATERIAL_DELIVERY
  WASTE_DISPOSAL
  FREIGHT_TRANSPORT
}

enum SurchargeType {
  FUEL          // Fuel levy
  WAITING_TIME  // Truck waiting at loading/unloading site
  WEEKEND       // Weekend / public holiday delivery
  OVERWEIGHT    // Cargo exceeds standard weight limit
  NARROW_ACCESS // Restricted site access (pump required, crane etc.)
  REMOTE_AREA   // Out-of-zone delivery surcharge
  TOLL          // Road toll pass-through
  OTHER         // Catch-all
}

// ================================
// PAYMENTS
// ================================

model Payment {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  payseraOrderId  String? // Paysera order UUID
  payseraPaymentUrl String? // Checkout redirect URL for buyer

  amount   Float // Total amount charged to buyer
  currency String @default("EUR")

  status PaymentStatus @default(PENDING)

  platformFee  Float? // B3Hub margin / revenue retained
  sellerPayout Float? // Amount owed to supplier(s) — recorded when payment RELEASED, paid out later via SupplierPayout
  driverPayout Float? // Amount owed to carrier/driver — recorded when payment RELEASED, paid out later via CarrierPayout

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Principal Payout Models ───────────────────────────────────────────────────
// B3Hub operates as principal: buyer pays B3Hub in full; B3Hub settles with
// suppliers and carriers separately on agreed payment terms (default NET-30).
// These models replace immediate Stripe Connect transfers — funds stay in
// B3Hub's platform account until the payout is explicitly executed by admin.

enum PayoutStatus {
  PENDING    // Obligation recorded; awaiting settlement batch
  PROCESSING // Paysera transfer initiated, awaiting confirmation
  PAID       // Transfer confirmed paid
  FAILED     // Transfer failed — manual action required
  CANCELLED  // Order cancelled/refunded; obligation voided
}

model SupplierPayout {
  id         String  @id @default(cuid())
  order      Order   @relation("OrderSupplierPayouts", fields: [orderId], references: [id])
  orderId    String
  supplier   Company @relation("SupplierPayouts", fields: [supplierId], references: [id])
  supplierId String

  amount   Float
  currency String @default("EUR")

  status    PayoutStatus @default(PENDING)
  dueDate   DateTime     // NET-30 from order completion date
  paidAt    DateTime?

  payseraTransferId String? // Populated when IBAN transfer is executed via Paysera Transfer API
  notes             String? // Free text — e.g. reason for manual override

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([dueDate])
  @@map("supplier_payouts")
}

model CarrierPayout {
  id        String        @id @default(cuid())
  order     Order?        @relation("OrderCarrierPayouts", fields: [orderId], references: [id])
  orderId   String?
  job       TransportJob? @relation("JobCarrierPayout", fields: [jobId], references: [id])
  jobId     String?       @unique
  driver    User?         @relation("DriverPayouts", fields: [driverId], references: [id])
  driverId  String?
  carrier   Company?      @relation("CarrierPayouts", fields: [carrierId], references: [id])
  carrierId String?

  amount   Float
  currency String @default("EUR")

  status    PayoutStatus @default(PENDING)
  dueDate   DateTime     // NET-30 from order completion date
  paidAt    DateTime?

  payseraTransferId String? // Populated when IBAN transfer is executed via Paysera Transfer API
  notes             String? // Free text — e.g. reason for manual override

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([carrierId])
  @@index([driverId])
  @@index([status])
  @@index([dueDate])
  @@map("carrier_payouts")
}

// ── RecyclerPayout ────────────────────────────────────────────────────────────
// Settlement record for amounts owed TO a recycling facility.
// Two scenarios:
//   1. Processing fee: recycler received waste and is owed a disposal/handling fee
//      from the buyer (routed via B3Hub principal model, NET-30).
//   2. Buyback payout: recycler collected scrap/metal from buyer and the buyer
//      is owed money — in this case amount is negative (platform pays the buyer,
//      not the recycler). RecyclerPayout tracks the recycler's obligation.
model RecyclerPayout {
  id        String  @id @default(cuid())

  // Source waste record (the processed intake that generated this obligation)
  wasteRecord   WasteRecord @relation(fields: [wasteRecordId], references: [id])
  wasteRecordId String      @unique

  // Recycling company that performed the processing
  recycler   Company @relation("RecyclerPayouts", fields: [recyclerId], references: [id])
  recyclerId String

  amount   Float  // EUR; positive = platform owes recycler; negative = recycler owes buyer
  currency String @default("EUR")

  status  PayoutStatus @default(PENDING)
  dueDate DateTime     // NET-30 from WasteRecord.processedDate

  paidAt DateTime?
  payseraTransferId String? // Populated when IBAN transfer is executed
  notes             String? // Manual override notes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recyclerId])
  @@index([status])
  @@index([dueDate])
  @@map("recycler_payouts")
}

model User {
  id                 String       @id @default(cuid())
  email              String?      @unique // optional: phone-only registration
  phone              String?      @unique // optional: email-only registration
  password           String?   // Hashed; null for phone-only accounts
  firstName          String
  lastName           String
  avatar             String?
  userType           UserType     @default(BUYER)
  isCompany          Boolean      @default(false) // true = company account (VAT invoices etc.)
  personalCode       String?      @unique // Latvian personal ID code (personas kods) — individuals only
  canBuy             Boolean      @default(true)  // approved to place orders as a buyer
  canSell            Boolean      @default(false) // approved to list & sell materials
  canTransport       Boolean      @default(false) // approved to offer transport services
  canRent            Boolean      @default(false) // approved to operate as an equipment rental provider
  canRecycle         Boolean      @default(false) // approved to operate a recycling/waste center
  companyRole        CompanyRole? // role within their company; null for solo accounts
  status             UserStatus   @default(ACTIVE) // buyers are auto-activated
  emailVerified      Boolean      @default(false)
  phoneVerified      Boolean      @default(false)
  pushToken          String? // Expo push token for native notifications
  resetToken         String? // password-reset token (hashed SHA-256)
  resetTokenExpiry   DateTime? // token expiry (1h window)
  refreshToken       String? // hashed refresh token (30-day sliding window)
  refreshTokenExpiry DateTime? // refresh token expiry
  emailVerifyToken   String?   // email verification token (hashed SHA-256)
  emailVerifyExpiry  DateTime? // verification token expiry (24h window)
  failedLoginAttempts Int       @default(0) // consecutive failed login attempts
  lockedUntil        DateTime? // account locked until this timestamp
  termsAcceptedAt    DateTime? // timestamp when user accepted T&C / Privacy Policy
  tokenVersion       Int       @default(0) // incremented on capability/role changes; JWT claims become stale if lower

  // Notification preferences
  notifPush         Boolean @default(true)
  notifOrderUpdates Boolean @default(true)
  notifJobAlerts    Boolean @default(true)
  notifMarketing    Boolean @default(false)

  // Company sub-user permissions (ignored for OWNER — they always have full access)
  permCreateContracts Boolean @default(false) // create & manage framework contracts
  permReleaseCallOffs Boolean @default(false) // release call-offs against contract positions
  permManageOrders    Boolean @default(false) // place, approve, cancel spot orders
  permViewFinancials  Boolean @default(false) // view invoices, prices, turnover
  permManageTeam      Boolean @default(false) // invite / remove / edit team members

  // Relations
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?

  // User-specific profiles
  driverProfile DriverProfile?
  buyerProfile  BuyerProfile?

  // Activity
  ordersCreated               Order[]
  driverJobs                  TransportJob[]          @relation("DriverJobs")
  requestedTransportJobs      TransportJob[]          @relation("RequestedJobs")
  notifications               Notification[]
  vehicles                    Vehicle[]
  reviews                     Review[]
  sentMessages                ChatMessage[]
  chatLastReads               ChatLastRead[]
  frameworkContracts          FrameworkContract[]
  createdProjects             Project[]
  reportedTransportExceptions TransportJobException[] @relation("ExceptionReporter")
  resolvedTransportExceptions TransportJobException[] @relation("ExceptionResolver")
  savedAddresses              SavedAddress[]
  savedPaymentMethods         SavedPaymentMethod[]
  adminAuditLogs              AdminAuditLog[]
  orderSchedules              OrderSchedule[]
  raisedDisputes              Dispute[]               @relation("UserDisputes")
  supportThread               SupportThread?
  supportMessages             SupportMessage[]
  fieldPasses                 FieldPass[]
  driverRatingsGiven          DriverRating[]          @relation("DriverRatingsGiven")
  driverRatingsReceived       DriverRating[]          @relation("BuyerRatingsReceived")
  driverPayouts               CarrierPayout[]         @relation("DriverPayouts")
  managedCompanies            Company[]               @relation("CompanyAccountManager")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/**
 * Ephemeral OTP record for phone-based authentication.
 * One row per phone number — upserted on each new OTP request.
 * Deleted once a user successfully verifies.
 */
model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String   @unique
  code      String   // SHA-256 hash of the 6-digit code
  expiresAt DateTime
  attempts  Int      @default(0) // failed verify attempts (blocked after 5)
  createdAt DateTime @default(now())

  @@map("phone_otps")
}

model Company {
  id              String      @id @default(cuid())
  name            String
  legalName       String
  registrationNum String?     @unique
  taxId           String?
  companyType     CompanyType
  features        CompanyFeature[] // Enabled SaaS feature modules for this company

  // Contact
  email   String
  phone   String
  website String?

  // Address
  street     String
  city       String
  state      String
  postalCode String
  country    String @default("LV")

  // Business info
  description String?
  logo        String?
  verified    Boolean @default(false)
  rating      Float?

  // B3 Group ownership flag — first-party participants on the marketplace
  isFirstParty Boolean @default(false) // true = owned by B3 Group (B3 Recycling, B3 Logistics, B3 Construction)

  // Payout & Commission
  ibanNumber            String? // IBAN for Paysera IBAN payouts (supplier / carrier)
  commissionRate        Float   @default(6.0) // Supplier platform fee % (applied to material subtotal)
  carrierCommissionRate Float   @default(8.0) // Carrier platform fee % (applied to deliveryFee)
  payoutEnabled         Boolean @default(false) // true once IBAN is verified

  // Billing settings — used on supplier-issued invoices
  paymentTermsDays Int?    // Default payment period in days (e.g. 14, 30). Falls back to 14 if null.

  // Marketplace billing agent agreement — supplier accepts that B3Hub generates
  // invoices on their behalf (required for Path 1 / disclosed agent model).
  billingAgentAgreedAt DateTime? // null = not yet accepted; non-null = accepted

  // Geo coordinates (set during onboarding — used for delivery-radius filtering in catalog)
  lat Float? // WGS-84 latitude of warehouse / base location
  lng Float? // WGS-84 longitude of warehouse / base location

  // Carrier operational area
  serviceRadiusKm Int? // Max km radius from base city for skip-hire jobs (null = no restriction)

  // Assigned account manager (Bilt platform staff — admin user)
  accountManager   User?   @relation("CompanyAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  accountManagerId String?

  // Performance stats — refreshed nightly by AnalyticsService.refreshSupplierStats()
  onTimePct      Float? // % of transport jobs delivered on time
  fulfillmentPct Float? // % of orders completed (not cancelled / rejected)

  // Relations
  users            User[]
  materials        Material[]
  containers       Container[]
  vehicles         Vehicle[]
  orders           Order[]
  recyclingCenters RecyclingCenter[]
  carrierJobs      TransportJob[]
  locations        SupplierLocation[]
  // Carrier comparison engine
  serviceZones               CarrierServiceZone[]         @relation("CarrierServiceZones")
  availabilityBlocks         CarrierAvailability[]        @relation("CarrierAvailability")
  assignedRentalOrders       RentalOrder[]                @relation("AssignedRentalCarrier")
  rentalListings             RentalListing[]              @relation("RentalListings")
  rentalOrdersAsProvider     RentalOrder[]                @relation("RentalOrderProvider")
  rentalSettings             CarrierRentalSettings[]
  reviews                    Review[]
  frameworkContracts         FrameworkContract[]   @relation("BuyerFrameworkContracts")
  supplierFrameworkContracts FrameworkContract[]   @relation("SupplierFrameworkContracts")
  projects                   Project[]
  apiKeys                    ApiKey[]
  fieldPasses                FieldPass[]
  advanceInvoices            Invoice[]             @relation("BuyerInvoices")
  sellerInvoices             Invoice[]             @relation("SellerInvoices")
  supplierPayouts            SupplierPayout[]      @relation("SupplierPayouts")
  carrierPayouts             CarrierPayout[]       @relation("CarrierPayouts")
  recyclerPayouts            RecyclerPayout[]      @relation("RecyclerPayouts")
  loadingSlots               SupplierLoadingSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

model Material {
  id          String           @id @default(cuid())
  name        String
  description String?
  category    MaterialCategory
  subCategory String?

  // Pricing
  basePrice Float
  unit      MaterialUnit
  currency  String       @default("EUR")

  // Stock & Availability
  inStock          Boolean @default(true)
  stockQty         Float?  // actual quantity in stock (null = unlimited / not tracked)
  minOrder         Float?
  maxOrder         Float?
  deliveryRadiusKm Int?    @default(100) // km radius the supplier delivers

  // Quality
  isRecycled   Boolean  @default(false)
  quality      String? // Quality grade
  certificates String[] // Certification IDs

  // Circular economy provenance (set when created from a WasteRecord)
  wasteRecordId      String? @unique // source WasteRecord → reverse of WasteRecord.producedMaterialId
  recoveryRate       Float?           // % of incoming waste that was recovered (copied from WasteRecord)
  provenanceFacility String?          // recycling facility name, for display on listing

  // Particle size fraction (e.g. "0/16", "16/32") — structured for filtering
  fraction String?

  // Pickup location — which quarry/site this material is loaded from
  pickupLocation   SupplierLocation? @relation(fields: [pickupLocationId], references: [id])
  pickupLocationId String?

  // Visibility
  featured Boolean @default(false) // promoted listing — sorted to top in catalog

  // Media
  images         String[]
  specifications Json?

  // Relations
  supplier            Company                      @relation(fields: [supplierId], references: [id])
  supplierId          String
  orderItems          OrderItem[]
  priceTiers          MaterialPriceTier[]
  availabilityBlocks  MaterialAvailabilityBlock[]

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([active, category])
  @@index([active, featured])
  @@map("materials")
}

model MaterialAvailabilityBlock {
  id         String   @id @default(cuid())
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId String

  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  note      String?

  createdAt DateTime @default(now())

  @@map("material_availability_blocks")
}

/// A specific quarry / loading site belonging to a supplier company.
/// Suppliers with multiple quarry locations create one record per site.
/// Materials reference their pickup location via Material.pickupLocationId.
model SupplierLocation {
  id         String  @id @default(cuid())
  name       String  // e.g. "Jaunbemberi"
  address    String  // full human-readable address
  city       String?
  postalCode String?
  country    String  @default("LV")

  lat Float? // WGS-84 latitude
  lng Float? // WGS-84 longitude

  active Boolean @default(true)

  supplier   Company @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String

  materials Material[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@map("supplier_locations")
}

model Container {
  id            String        @id @default(cuid())
  containerType ContainerType
  size          ContainerSize
  volume        Float // in m3
  maxWeight     Float // in tonnes

  // Pricing
  rentalPrice Float // per day
  deliveryFee Float
  pickupFee   Float
  currency    String @default("EUR")

  // Availability
  status   ContainerStatus
  location String? // Current location

  // Relations
  owner           Company          @relation(fields: [ownerId], references: [id])
  ownerId         String
  containerOrders ContainerOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("containers")
}

model Order {
  id          String    @id @default(cuid())
  orderNumber String    @unique
  orderType   OrderType

  // Customer info
  buyer       Company @relation(fields: [buyerId], references: [id])
  buyerId     String
  createdBy   User    @relation(fields: [createdById], references: [id])
  createdById String

  // Delivery details
  deliveryAddress String
  deliveryCity    String
  deliveryState   String
  deliveryPostal  String
  deliveryLat     Float?   // GPS latitude of delivery site — used for route distance & driver matching
  deliveryLng     Float?   // GPS longitude of delivery site
  deliveryDate    DateTime?
  deliveryWindow  String? // e.g., "8:00-12:00"

  // Fulfillment type — DELIVERY (default) or PICKUP at a B3 Field
  fulfillmentType OrderFulfillmentType @default(DELIVERY)
  pickupField     B3Field?    @relation(fields: [pickupFieldId], references: [id])
  pickupFieldId   String?
  pickupSlot      PickupSlot? @relation(fields: [pickupSlotId], references: [id])
  pickupSlotId    String?

  // Pricing
  subtotal    Float
  tax         Float
  deliveryFee Float
  total       Float
  currency    String @default("EUR")

  // Status
  status         OrderStatus
  paymentStatus  PaymentStatus
  paymentMethod  PaymentMethod @default(CARD) // CARD = pay now; INVOICE = NET terms

  // Site contact (foreman / on-site contact the driver can call)
  siteContactName  String?
  siteContactPhone String?

  // Unloading-point photo — buyer can photograph the exact drop zone when placing the order
  sitePhotoUrl  String?

  // Unloading in absence — buyer indicates no one will be present at delivery
  // Driver should follow access instructions in notes and photo-proof the drop.
  noContactOnSite Boolean @default(false)

  // Precise unloading pin — buyer can drag a map pin to the exact spot within the site
  // (distinct from deliveryLat/Lng which is the geocoded street address)
  unloadLat Float?
  unloadLng Float?

  // Special instructions
  notes         String?
  internalNotes String?

  // BIS (Būvniecības informācijas sistēma) case reference — required for waste disposal orders
  // on construction sites. Collected in the wizard and stored for APUS reporting.
  bisNumber String?

  // Scrap buyback — when true the buyer receives payment instead of paying disposal fee.
  // buyerPayoutAmount is the agreed amount (based on buybackPricePerTonne × estimated weight)
  // that the platform owes the buyer after collection is confirmed by the recycler.
  isBuyback         Boolean @default(false)
  buyerPayoutAmount Float?  // EUR; set when order is created with a fixed buyback quote

  // Buyer's internal purchase order reference (B2B procurement matching)
  poNumber  String?

  // Multi-truck staggered delivery
  truckCount           Int @default(1) // number of separate truck runs
  truckIntervalMinutes Int? // minutes between consecutive trucks; null = all at once

  // Recurring order schedule — if this order spawned from a schedule
  scheduleId String?
  schedule   OrderSchedule? @relation(fields: [scheduleId], references: [id])

  // Public tracking — unauthenticated share link
  trackingToken String? @unique

  // International shipment flag — determines legal document type:
  // false (default) = domestic → Kravas pavadzīme (Latvian cargo bill of lading)
  // true = cross-border → CMR Note (1956 CMR Convention)
  isInternational Boolean @default(false)

  // Timestamps for each status transition — { STATUS: ISO8601 }
  statusTimestamps Json?

  // Relations
  items           OrderItem[]
  containerOrders ContainerOrder[]
  transportJobs   TransportJob[]
  invoices        Invoice[]
  payment         Payment?
  surcharges      OrderSurcharge[]
  dispute         Dispute?
  chatMessages    ChatMessage[]    @relation("OrderChatMessages")
  fieldPasses     FieldPass[]
  supplierPayouts SupplierPayout[] @relation("OrderSupplierPayouts")
  carrierPayouts  CarrierPayout[]  @relation("OrderCarrierPayouts")
  wasteRecords    WasteRecord[]    @relation("DisposalWasteRecord")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trackingToken])
  @@index([scheduleId])
  @@index([buyerId])
  @@index([createdById])
  @@index([status])
  @@index([status, createdAt])
  @@map("orders")
}

// ── Guest Order ───────────────────────────────────────────────────────────────
// Unauthenticated B2C order submitted from the public landing page.
// Not linked to any User or Company — just contact info + delivery details.
// Admin/seller is notified and can contact the guest directly, or the guest
// can later register and have the order converted to a real Order.
model GuestOrder {
  id          String           @id @default(cuid())
  orderNumber String           @unique
  token       String           @unique // public tracking token — /order/[token]

  // Category discriminator (MATERIAL | SKIP_HIRE | TRANSPORT | DISPOSAL)
  category String @default("MATERIAL")

  // ── MATERIAL specific (nullable for other categories) ──
  materialCategory String?  // mirrors MaterialCategory enum values
  materialName     String?
  quantity         Float?
  unit             String?  // TONNE | M3 | KG | PIECE

  // ── TRANSPORT specific ──
  pickupAddress    String?
  pickupCity       String?
  pickupLat        Float?
  pickupLng        Float?
  vehicleType      String?   // TransportVehicleType enum value
  cargoDescription String?
  estimatedWeight  Float?

  // ── DISPOSAL specific ──
  wasteTypes     String?  // JSON string array e.g. '["CONCRETE","SOIL"]'
  disposalVolume Float?
  truckType      String?  // DisposalTruckType enum value

  // Where (shared — delivery/placement/dropoff address)
  deliveryAddress String
  deliveryCity    String
  deliveryPostal  String?
  deliveryLat     Float?
  deliveryLng     Float?

  // When
  deliveryDate   DateTime?
  deliveryWindow String?   // e.g. "08:00-12:00"

  // Who (guest contact — no account required)
  contactName  String
  contactPhone String
  contactEmail String?
  notes        String?

  // Lifecycle
  status GuestOrderStatus @default(PENDING)

  // Optional: if converted, link to the real order
  convertedOrderId String? @unique

  // Paysera payment — populated when guest initiates checkout
  payseraOrderId    String? // Paysera order UUID
  payseraPaymentUrl String? // Checkout redirect URL sent to guest
  paymentStatus     String? // 'PENDING' | 'PAID' | 'FAILED'

  // Price quoted to guest (set by admin before sending payment link)
  quotedAmount   Float?
  quotedCurrency String @default("EUR")

  // Regulatory — BIS case reference for construction waste disposal (required by Latvian law)
  bisNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([token])
  @@index([status])
  @@index([contactPhone])
  @@map("guest_orders")
}

enum GuestOrderStatus {
  PENDING    // received, awaiting admin/seller action
  CONTACTED  // admin or seller has reached out to the guest
  CONVERTED  // guest registered and order moved to Order model
  CANCELLED
}

model OrderItem {
  id String @id @default(cuid())

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  material   Material @relation(fields: [materialId], references: [id])
  materialId String

  quantity  Float
  unit      MaterialUnit
  unitPrice Float
  total     Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order_items")
}

model ContainerOrder {
  id String @id @default(cuid())

  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  container   Container @relation(fields: [containerId], references: [id])
  containerId String

  // Rental period
  startDate     DateTime
  endDate       DateTime?
  actualEndDate DateTime?

  // Purpose
  purpose         WastePurpose
  wasteType       WasteType?
  estimatedWeight Float?
  actualWeight    Float?

  // Pricing
  rentalDays  Int
  dailyRate   Float
  deliveryFee Float
  pickupFee   Float
  disposalFee Float?
  total       Float

  // Status
  status ContainerOrderStatus

  // Delivery & Pickup
  deliveryJob   TransportJob? @relation("ContainerDelivery", fields: [deliveryJobId], references: [id])
  deliveryJobId String?
  pickupJob     TransportJob? @relation("ContainerPickup", fields: [pickupJobId], references: [id])
  pickupJobId   String?
  wasteRecords  WasteRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("container_orders")
}

model TransportJob {
  id        String           @id @default(cuid())
  jobNumber String           @unique
  jobType   TransportJobType

  // Job details
  order   Order?  @relation(fields: [orderId], references: [id])
  orderId String?

  // Pickup
  pickupAddress String
  pickupCity    String
  pickupState   String
  pickupPostal  String
  pickupDate    DateTime
  pickupWindow  String?

  // Delivery
  deliveryAddress String
  deliveryCity    String
  deliveryState   String
  deliveryPostal  String
  deliveryDate    DateTime
  deliveryWindow  String?

  // Cargo
  cargoType           String
  cargoWeight         Float? // estimated weight in tonnes
  cargoVolume         Float?
  actualWeightKg      Float? // actual weigh-bridge reading at pickup
  pickupPhotoUrl      String? // weighing slip photo taken by driver at pickup
  specialRequirements String?

  // Required vehicle
  requiredVehicleType String? // human-readable e.g. "Sattelkipper"
  requiredVehicleEnum VehicleType?

  // Staggered delivery — which run this job represents (1-based)
  truckIndex Int?

  // Geo coords for radius filtering
  pickupLat   Float?
  pickupLng   Float?
  deliveryLat Float?
  deliveryLng Float?
  distanceKm  Float?

  // Pricing
  rate              Float
  pricePerTonne     Float?
  buyerOfferedRate  Float?   // buyer's suggested budget; shown to drivers
  currency          String @default("EUR")

  // Assignment
  carrier   Company? @relation(fields: [carrierId], references: [id])
  carrierId String?
  driver    User?    @relation("DriverJobs", fields: [driverId], references: [id])
  driverId  String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleId String?

  // Framework contract call-off
  frameworkContract   FrameworkContract? @relation(fields: [frameworkContractId], references: [id])
  frameworkContractId String?
  frameworkPosition   FrameworkPosition? @relation("PositionCallOffs", fields: [frameworkPositionId], references: [id])
  frameworkPositionId String?

  // The buyer/user who originally requested this disposal or freight job
  requester     User?   @relation("RequestedJobs", fields: [requestedById], references: [id])
  requestedById String? @map("requested_by_id")

  // Recycling center destination (set for WASTE_COLLECTION jobs)
  recyclingCenter   RecyclingCenter? @relation(fields: [recyclingCenterId], references: [id])
  recyclingCenterId String?

  // Status
  status TransportJobStatus

  // SLA / escalation tracking
  acceptedAt         DateTime?
  statusUpdatedAt    DateTime?
  slaEscalatedAt     DateTime?
  slaEscalationStage String?

  // Per-status timestamps — JSON map of { STATUS: ISO-8601 string }
  // e.g. { "ACCEPTED": "2026-04-19T10:00:00Z", "EN_ROUTE_PICKUP": "..." }
  statusTimestamps Json?

  // Tracking
  currentLocation  Json?
  estimatedArrival DateTime?

  // Carrier arrival scheduling (driver sets ETA after accepting)
  plannedArrivalAt    DateTime? // driver's committed arrival time
  arrivalWindowStart  DateTime? // plannedArrivalAt - 90 min
  arrivalWindowEnd    DateTime? // plannedArrivalAt + 90 min

  // Proof of delivery
  deliveryProof DeliveryProof?

  // Auto-dispatch offer
  offeredToDriverId String?   // current driver being offered this job
  offerExpiresAt    DateTime? // offer expires at this time (45 seconds from dispatch)
  declinedDriverIds String[]  @default([]) // driver IDs who declined or timed out

  // Relations
  containerDeliveries ContainerOrder[]        @relation("ContainerDelivery")
  containerPickups    ContainerOrder[]        @relation("ContainerPickup")
  chatMessages        ChatMessage[]
  exceptions          TransportJobException[]
  invoices            Invoice[]
  surcharges          OrderSurcharge[]        @relation("JobSurcharges")
  driverRating        DriverRating?
  carrierPayout       CarrierPayout?          @relation("JobCarrierPayout")

  // Site coordination — set for WASTE_COLLECTION (disposal) jobs
  notes                String?  // driver instructions / access notes
  siteContactName      String?  // pickup/on-site contact (foreman, site manager)
  siteContactPhone     String?  // pickup contact phone
  receiverContactName  String?  // delivery recipient name (who signs at dropoff)
  receiverContactPhone String?  // delivery recipient phone
  bisNumber            String?  // BIS case reference (construction waste tracking)
  // Loading coordination
  loadingBy            String?  // 'BUYER_CREW' | 'DRIVER_HANDS' | 'NEEDS_MACHINERY'
  contactWillBePresent Boolean? // site contact confirmed to be present during pickup
  wasteReadiness       String?  // 'PILED' | 'NEEDS_PREP' — state of waste at site

  // Supplier loading slot booking
  loadingSlot   SupplierLoadingSlot? @relation("JobLoadingSlot", fields: [loadingSlotId], references: [id], onDelete: SetNull)
  loadingSlotId String?

  // Dispatch mode: SCHEDULED (default, pre-planned) or ON_DEMAND (hotshot — book now, dispatch immediately)
  dispatchMode  String @default("SCHEDULED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId])
  @@index([carrierId])
  @@index([orderId])
  @@index([status])
  @@index([status, pickupDate])
  @@map("transport_jobs")
}

model TransportJobException {
  id String @id @default(cuid())

  transportJob   TransportJob @relation(fields: [transportJobId], references: [id], onDelete: Cascade)
  transportJobId String

  type      TransportExceptionType
  status    TransportExceptionStatus @default(OPEN)
  notes     String
  photoUrls String[]

  reportedBy   User   @relation("ExceptionReporter", fields: [reportedById], references: [id])
  reportedById String

  resolvedBy   User?   @relation("ExceptionResolver", fields: [resolvedById], references: [id])
  resolvedById String?
  resolution   String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([transportJobId, status])
  @@map("transport_job_exceptions")
}

model DeliveryProof {
  id             String       @id @default(cuid())
  transportJob   TransportJob @relation(fields: [transportJobId], references: [id])
  transportJobId String       @unique

  // Signatures
  recipientName      String
  recipientSignature String // Base64 or URL
  driverSignature    String // Base64 or URL

  // Photos
  photos String[] // URLs

  // Timestamps
  deliveredAt DateTime

  // Notes
  notes String?

  // GPS coordinates captured at the moment of proof submission
  proofLat Float?
  proofLng Float?

  // Structured checklist fields
  loadCondition  String?  // 'FULL' | 'PARTIAL' | 'DAMAGED'
  isPartialLoad  Boolean  @default(false)
  hasDamage      Boolean  @default(false)
  damageNote     String?
  gradeConfirmed Boolean  @default(false)

  createdAt DateTime @default(now())

  @@map("delivery_proofs")
}

model Vehicle {
  id           String  @id @default(cuid())
  make         String
  model        String
  year         Int
  licensePlate String  @unique
  vin          String?
  imageUrl     String?

  // Type & Capacity
  vehicleType    VehicleType
  capacity       Float // load weight in tonnes
  maxGrossWeight Float? // total permitted weight in tonnes
  volumeCapacity Float? // in m3
  driveType      String? // '4WD', 'AWD', '2WD', etc.

  // Individual owner (solo CARRIER without a company)
  owner   User?   @relation(fields: [ownerId], references: [id])
  ownerId String?

  // Company owner
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?

  // Status
  status          VehicleStatus @default(ACTIVE)
  currentLocation Json?

  // Insurance & Compliance
  insuranceExpiry  DateTime?
  inspectionExpiry DateTime?

  // Relations
  transportJobs TransportJob[]
  assignments   VehicleAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicles")
}

model RecyclingCenter {
  id   String @id @default(cuid())
  name String

  // Location
  address     String
  city        String
  state       String
  postalCode  String
  coordinates Json? // {lat, lng}

  // Owner
  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  // Capabilities
  acceptedWasteTypes WasteType[]
  capacity           Float // tonnes per day
  certifications     String[]

  // Operating hours
  operatingHours Json // {monday: {open, close}, ...}

  // APUS / licensing
  licensed           Boolean @default(false) // true = VVD-licensed recycling facility (Gulbene)
  licenceNumber      String? // VVD waste management licence number (e.g. "VVD/RA/4-04/315")
  apusRegistrationId String? // VVD-issued APUS facility registration number (for electronic waste movement reporting)

  // Status
  active Boolean @default(true)

  // Relations
  wasteRecords  WasteRecord[]
  incomingJobs  TransportJob[] // WASTE_COLLECTION jobs destined for this center
  b3Field       B3Field? // reverse of B3Field.recyclingCenter
  pricingRules  RecyclingCenterPricingRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("recycling_centers")
}

model RecyclingCenterPricingRule {
  id String @id @default(cuid())

  recyclingCenter   RecyclingCenter @relation(fields: [recyclingCenterId], references: [id], onDelete: Cascade)
  recyclingCenterId String

  wasteType            WasteType
  pricePerTonne        Float  // EUR per tonne (disposal fee charged to buyer; 0 = free disposal)
  buybackPricePerTonne Float? // EUR per tonne the center PAYS to the buyer (metal buyback, scrap); null = no buyback offered
  minimumWeight        Float? // minimum load in tonnes; if below → minimumFee applies
  minimumFee           Float? // flat charge when load < minimumWeight
  maximumWeight        Float? // center won't accept loads heavier than this per booking
  accepted             Boolean @default(true) // false = center does not accept this waste type
  notes                String? // operator notes shown to buyer ("No ceramics mixed in")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recyclingCenterId, wasteType])
  @@map("recycling_center_pricing_rules")
}

model WasteRecord {
  id String @id @default(cuid())

  // Source
  containerOrder   ContainerOrder? @relation(fields: [containerOrderId], references: [id])
  containerOrderId String?

  // Recycling center
  recyclingCenter   RecyclingCenter @relation(fields: [recyclingCenterId], references: [id])
  recyclingCenterId String

  // Waste details
  wasteType WasteType
  weight    Float
  volume    Float?

  // Processing
  processedDate    DateTime?
  recyclableWeight Float?
  recyclingRate    Float? // percentage

  // Processing lifecycle stage
  processingStage WasteProcessingStage @default(RECEIVED)

  // Quality grading (assessed after processing)
  rcGrade RcGrade @default(UNGRADED)

  // Weighbridge documentation
  weighbridgeTicketRef String? // official weigh ticket number / reference from the physical weighbridge
  weighbridgePhotoUrl  String? // upload of the weigh ticket document

  // Output
  producedMaterialId String? // If converted to recycled material

  // Compliance
  certificateUrl String?

  // APUS (Atkritumu plūsmu uzskaites sistēma) — VVD mandatory reporting
  apusStatus       ApusStatus @default(PENDING)
  apusSubmissionId String?    // reference ID returned by APUS after submission
  apusSubmittedAt  DateTime?
  apusNote         String?    // rejection reason or manual staff note
  bisNumber        String?    // BIS case reference from source Order (for construction waste)

  // LV/EU waste catalogue code — auto-populated from lv-waste-codes mapping
  lvWasteCode String? // e.g. "17 01 01" (concrete) — used in APUS submission

  // Source Order link (disposal orders that created this record)
  order   Order?  @relation("DisposalWasteRecord", fields: [orderId], references: [id])
  orderId String?

  // Payout obligation (set when processing is complete)
  recyclerPayout RecyclerPayout?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("waste_records")
}

model DriverProfile {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  // License info
  licenseNumber String   @unique
  licenseType   String[] // ["B", "C", "CE"]
  licenseExpiry DateTime

  // Certifications
  certifications String[]

  // Performance
  rating        Float?
  completedJobs Int    @default(0)
  noShowCount   Int    @default(0)  // incremented on every driver-initiated cancellation

  // Status
  available       Boolean @default(true) // legacy; now derived from isOnline + schedule
  isOnline        Boolean @default(false) // driver tapped "Go Online"
  autoSchedule    Boolean @default(false) // auto toggle based on weeklySchedule
  maxJobsPerDay   Int? // cap on daily job accepts; null = unlimited
  currentLocation Json?

  // Payout info for individual owner-operators (no company)
  ibanNumber    String? // IBAN for Paysera IBAN payouts
  payoutEnabled Boolean @default(false) // true once IBAN is set and verified

  // Job search radius — driver only receives job alerts and sees board entries within this radius
  searchRadiusKm Int @default(50)

  // Schedule relations
  weeklySchedule DriverSchedule[]
  dateBlocks     DriverDateBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("driver_profiles")
}

model BuyerProfile {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  // Preferences
  preferredSuppliers String[]
  preferredCarriers  String[]

  // Credit
  creditLimit  Float?
  creditUsed   Float   @default(0)
  paymentTerms String? // e.g., "NET30"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("buyer_profiles")
}

model Notification {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  type    NotificationType
  title   String
  message String
  data    Json? // Additional data

  read   Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
  @@map("notifications")
}

model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique

  order   Order?  @relation(fields: [orderId], references: [id])
  orderId String?

  // Framework contract call-off billing: invoice linked to a transport job (no Order record)
  transportJob   TransportJob? @relation(fields: [transportJobId], references: [id])
  transportJobId String?

  // B3 Fields — advance payment invoice linked to a field contract
  advanceForContract   FrameworkContract? @relation("AdvanceInvoices", fields: [advanceForContractId], references: [id])
  advanceForContractId String?

  // Buyer — who this invoice belongs to (set for advance invoices; derived from order for order invoices)
  buyerCompany   Company? @relation("BuyerInvoices", fields: [buyerCompanyId], references: [id])
  buyerCompanyId String?

  // Marketplace / Path 1: which company is the legal seller on this invoice.
  // Null = B3Hub is the issuer (legacy / commission invoices).
  // Non-null = supplier-issued invoice generated by B3Hub acting as billing agent.
  sellerCompany   Company? @relation("SellerInvoices", fields: [sellerCompanyId], references: [id])
  sellerCompanyId String?

  // Commission invoice — B3Hub's platform fee invoice issued TO the supplier.
  // When true: buyerCompanyId = supplier company, sellerCompanyId = null (B3Hub is issuer).
  isCommissionInvoice    Boolean  @default(false)
  commissionForInvoiceId String?  // links to the supplier-issued invoice this fee is based on

  // Amounts
  subtotal Float
  tax      Float
  total    Float
  currency String @default("EUR")

  // Payment
  dueDate       DateTime
  paidDate      DateTime?
  paymentStatus PaymentStatus

  // Documents
  pdfUrl String?

  // VAT compliance fields — required by LV Cabinet Regulation No. 585 (VAT Directive)
  supplierVatNumber   String? // Piegādātāja PVN reģistrācijas numurs
  buyerVatNumber      String? // Pircēja PVN reģistrācijas numurs
  taxPeriod           String? // Nodokļa periods, e.g. "Aprīlis 2026"
  supplierBankAccount String? // Piegādātāja bankas konts un BIC

  // Credit notes — cancels or reduces an already-issued invoice (kredītrēķins)
  isCreditNote    Boolean  @default(false)
  creditNoteForId String?
  creditNoteFor   Invoice? @relation("InvoiceCreditNotes", fields: [creditNoteForId], references: [id], onDelete: SetNull)
  creditNotes     Invoice[] @relation("InvoiceCreditNotes")
  notes           String?  // Free-text reason, e.g. credit note explanation

  // Paysera payment link — populated for INVOICE-method orders so buyer can pay online
  payseraPaymentLinkId  String?
  payseraPaymentLinkUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creditNoteForId])
  @@index([sellerCompanyId])
  @@index([isCommissionInvoice])
  @@map("invoices")
}

// ── Digital Documents ─────────────────────────────────────────

enum DocumentType {
  INVOICE // Invoice / bill
  WEIGHING_SLIP // Weight certificate when materials are loaded / delivered
  DELIVERY_PROOF // Signed proof of delivery with photos
  WASTE_CERTIFICATE // Recycling / waste processing certificate
  DELIVERY_NOTE // Kravas pavadzīme (domestic) or CMR Note (cross-border) — pre-generated at job accept
  WASTE_TRANSPORT_NOTE // Atkritumu pārvadājuma pavadzīme — required pre-transport waste document (LV law)
  CONTRACT // Agreement / contract between parties
  OTHER
}

enum DocumentStatus {
  DRAFT
  ISSUED
  SIGNED
  ARCHIVED
}

enum DocumentEntityType {
  ORDER
  INVOICE
  TRANSPORT_JOB
  WASTE_RECORD
  SKIP_HIRE_ORDER
  FRAMEWORK_CONTRACT
  FRAMEWORK_POSITION
  COMPANY
  PROJECT
}

enum DocumentLinkRole {
  PRIMARY
  RELATED
  SUPPORTING
}

model Document {
  id     String         @id @default(cuid())
  title  String
  type   DocumentType
  status DocumentStatus @default(ISSUED)

  // Storage
  fileUrl  String? // Supabase / S3 signed URL
  mimeType String? // application/pdf, image/jpeg, …
  fileSize Int? // bytes

  // Linked entities (all optional – attach to whatever is relevant)
  orderId        String?
  invoiceId      String?
  transportJobId String?
  wasteRecordId  String?

  // Ownership
  ownerId  String // User who can see this document
  issuedBy String? // Company / system that issued it

  // Metadata
  isGenerated Boolean   @default(false) // true = auto-generated by backend
  notes       String?
  expiresAt   DateTime?

  // Contextual links (one document can belong to many entities)
  links DocumentLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("documents")
}

model DocumentLink {
  id String @id @default(cuid())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  entityType DocumentEntityType
  entityId   String
  role       DocumentLinkRole   @default(RELATED)

  createdAt DateTime @default(now())

  @@unique([documentId, entityType, entityId, role])
  @@index([entityType, entityId])
  @@map("document_links")
}

// ── Rental listing — a specific piece of equipment or service offered by a provider ──
// Wolt model: providers manage their own fleet/catalog; buyers browse and pick a listing.
// Dispatch-model orders (legacy) have listingId = null.
model RentalListing {
  id         String            @id @default(cuid())
  provider   Company           @relation("RentalListings", fields: [providerId], references: [id], onDelete: Cascade)
  providerId String

  serviceType       RentalServiceType
  name              String            // e.g. "CAT 308 CR Mini Excavator"
  // Sub-category label shown in ALL CAPS below the H1 (e.g. "HYDRAULIC SOIL DRILLS")
  subCategoryLabel  String?
  // Provider-facing product/asset code for support references (e.g. "151010")
  productCode       String?
  description       String?
  unitLabel         String            @default("vienība")
  yearOfManufacture Int?

  // Pricing
  pricePerDay       Float
  currency          String            @default("EUR")
  vatRate           Float             @default(21)

  // Hire period constraints
  minHireDays       Int               @default(1)
  maxHireDays       Int?

  // Available hire period options — [{ days: 1, label: "1 diena" }, ...]
  hirePeriodOptions Json              @default("[]")

  // Fleet quantity
  quantityTotal     Int               @default(1)

  // Coverage
  coverageCities    String[]
  deliveryRadiusKm  Float?
  freeDeliveryRadiusKm Float?
  deliveryFeePerKm  Float?
  // Provider base coordinates — used to check if delivery address is within radius
  providerLat       Float?
  providerLng       Float?

  // Self-collect option
  selfCollectAvailable Boolean        @default(false)
  selfCollectAddress   String?
  selfCollectLat       Float?
  selfCollectLng       Float?

  // Availability — provider marks dates as blocked (fully-booked or unavailable)
  // Stored as array of ISO date strings "YYYY-MM-DD"
  blockedDates      String[]

  // Media
  imageUrls         String[]
  // Document URLs — { ce?: string, inspection?: string, manual?: string }
  documentUrls      Json?

  // Free-form machine specs — e.g. { weight: "5.8t", reach: "5.2m", bucket: "0.3m³" }
  specs             Json?

  // Optional extras — AddOnDef[]
  // { id, name, description?, pricePerDay?, priceFlat?, category, minQty, maxQty }
  addOns            Json?

  // Insurance tiers — InsuranceDef[]
  // { id, name, description, pricePerDay, excess, coversTheft, coversThirdParty, isRequired }
  insuranceOptions  Json?
  // If true, buyer must select at least the cheapest paid insurance tier
  insuranceRequired Boolean           @default(false)

  // Security deposit
  depositAmount     Float?
  // ONLINE_BEFORE | ON_DELIVERY | NONE
  depositMethod     String?

  // Policies
  // FULL_TO_FULL | INCLUDED | CHARGED_ON_RETURN
  fuelPolicy        String?
  // FREE_UNTIL_48H | FREE_UNTIL_24H | NON_REFUNDABLE
  cancellationPolicy String?
  lateReturnFeePerDay Float?

  // Required buyer documents — { licenseType?, ownInsuranceRequired, siteInductionRequired }
  requiredDocuments Json?

  isActive Boolean @default(true)

  orders RentalOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId])
  @@index([serviceType, isActive])
  @@map("rental_listings")
}

// ── Generic rental order — for all future rental service types ──────────────
// New services (scaffolding, generators, fencing, site offices, etc.) use this
// single table. Service-specific configuration lives in `metadata` JSON.
model RentalOrder {
  id          String @id @default(cuid())
  orderNumber String @unique

  // Service type — determines what metadata fields are expected
  serviceType RentalServiceType

  // Delivery location (canonical address form for all rental types)
  address String
  city    String
  lat     Float?
  lng     Float?

  // Hire period
  hireDays       Int
  deliveryDate   DateTime
  deliveryWindow String?  // 'AM' | 'PM' | 'ANY'

  // Service-specific fields — e.g. { scaffoldingHeight: 6, fencingMetres: 50 }
  metadata Json?

  // Quantity (e.g. number of generators, sections of fencing)
  quantity Int @default(1)

  // Pricing (stored at time of order)
  price    Float
  currency String @default("EUR")

  // VAT breakdown — stored at order time so receipts are always accurate
  priceExclVat      Float?
  vatRate           Float?
  vatAmount         Float?
  priceTotalInclVat Float?

  // Delivery fee charged to buyer
  deliveryFee Float?

  // Selected add-ons snapshot — [{ id, name, pricePerDay?, priceFlat?, qty, lineTotal }]
  selectedAddOns Json?

  // Insurance snapshot
  insurancePlanId      String?
  insurancePlanName    String?
  insurancePricePerDay Float?

  // Security deposit
  depositAmount Float?
  depositPaid   Boolean @default(false)

  // Payment
  paymentMethod     PaymentMethod @default(CARD)
  payseraOrderId    String?
  payseraPaymentUrl String?
  paymentStatus     PaymentStatus @default(PENDING)

  // Status lifecycle
  status RentalOrderStatus @default(PENDING)

  // Contact (guest or registered user)
  contactName  String?
  contactEmail String?
  contactPhone String?
  userId       String?

  // Listing-based (marketplace model) — null for legacy dispatch orders
  listing    RentalListing? @relation(fields: [listingId], references: [id])
  listingId  String?

  // Provider who fulfils this order — set at booking (listing model) or on assign (dispatch)
  provider   Company? @relation("RentalOrderProvider", fields: [providerId], references: [id])
  providerId String?

  // Carrier assigned
  carrier   Company? @relation("AssignedRentalCarrier", fields: [carrierId], references: [id])
  carrierId String?

  // Live driver location — { lat, lng, updatedAt }
  currentLocation Json?

  // Public unauthenticated tracking share link
  trackingToken String? @unique

  notes            String?
  statusTimestamps Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trackingToken])
  @@index([userId])
  @@index([carrierId])
  @@index([listingId])
  @@index([providerId])
  @@index([serviceType, status])
  @@map("rental_orders")
}

// Carrier pricing for generic rental services.
// One row per carrier per service type.
model CarrierRentalSettings {
  id          String            @id @default(cuid())
  carrier     Company           @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  carrierId   String
  serviceType RentalServiceType

  pricePerUnitPerDay Float    // EUR per unit per day
  cities             String[] // list of cities/regions served

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([carrierId, serviceType])
  @@map("carrier_rental_settings")
}

// ── Carrier comparison engine ─────────────────────────────────────────────────

model CarrierServiceZone {
  id        String  @id @default(cuid())
  carrier   Company @relation("CarrierServiceZones", fields: [carrierId], references: [id], onDelete: Cascade)
  carrierId String

  city      String // e.g. "Rīga", "Jūrmala"
  postcode  String? // optional tighter targeting
  surcharge Float   @default(0)

  createdAt DateTime @default(now())

  @@map("carrier_service_zones")
}

model CarrierAvailability {
  id        String  @id @default(cuid())
  carrier   Company @relation("CarrierAvailability", fields: [carrierId], references: [id], onDelete: Cascade)
  carrierId String

  blockedDate DateTime @db.Date
  reason      String?

  createdAt DateTime @default(now())

  @@unique([carrierId, blockedDate])
  @@map("carrier_availability")
}

// ── Provider Applications (supply/transport onboarding) ─────────────────────
model ProviderApplication {
  id String @id @default(cuid())

  // Applicant identity
  email     String
  firstName String
  lastName  String
  phone     String

  // Company details
  companyName String
  regNumber   String?
  taxId       String?
  website     String?

  // What they want to do
  appliesForSell      Boolean @default(false) // wants canSell
  appliesForTransport Boolean @default(false) // wants canTransport

  // Supporting info
  description String? // Free-text: describe your business

  // Linked to an existing user (optional — may apply before registering)
  userId String?

  // Review
  status     ApplicationStatus @default(PENDING)
  reviewedBy String? // Admin userId who reviewed
  reviewNote String? // Admin note

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("provider_applications")
}

// ── Driver scheduling ─────────────────────────────────────────────────────────

// Recurring weekly work hours (one row per day of week the driver works)
model DriverSchedule {
  id String @id @default(cuid())

  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  driverProfileId String

  dayOfWeek Int // 0 = Sunday … 6 = Saturday
  enabled   Boolean @default(true)
  startTime String // "07:00" (local time, HH:mm)
  endTime   String // "18:00"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([driverProfileId, dayOfWeek])
  @@map("driver_schedules")
}

// Specific dates the driver cannot work (vacation, sick day, personal)
model DriverDateBlock {
  id String @id @default(cuid())

  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  driverProfileId String

  blockedDate DateTime
  reason      String?

  createdAt DateTime @default(now())

  @@unique([driverProfileId, blockedDate])
  @@map("driver_date_blocks")
}

// ── Reviews / Ratings ─────────────────────────────────────────────────────────

// A buyer review submitted after a completed order
model Review {
  id      String  @id @default(cuid())
  rating  Int // 1–5 stars
  comment String?

  reviewer   User   @relation(fields: [reviewerId], references: [id])
  reviewerId String

  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  // Exactly one of these is set per review
  orderId          String? @unique // material order
  transportJobId   String? @unique // driver rating (buyer rates driver post-delivery)

  // Set for driver ratings — the individual driver being rated
  driverId String?

  createdAt DateTime @default(now())

  @@map("reviews")
}

// ── Driver → Buyer reverse rating ─────────────────────────────────────────────
// Driver rates the buyer's site/instructions after a delivered transport job.

model DriverRating {
  id      String  @id @default(cuid())
  rating  Int     // 1–5 stars
  comment String?

  driver   User   @relation("DriverRatingsGiven", fields: [driverId], references: [id])
  driverId String

  buyer   User   @relation("BuyerRatingsReceived", fields: [buyerId], references: [id])
  buyerId String

  transportJob   TransportJob @relation(fields: [transportJobId], references: [id])
  transportJobId String       @unique

  createdAt DateTime @default(now())

  @@map("driver_ratings")
}

// ── Per-job Chat ──────────────────────────────────────────────────────────────

model ChatMessage {
  id String @id @default(cuid())

  transportJob   TransportJob? @relation(fields: [transportJobId], references: [id], onDelete: Cascade)
  transportJobId String?

  order   Order? @relation("OrderChatMessages", fields: [orderId], references: [id], onDelete: Cascade)
  orderId String?

  sender   User   @relation(fields: [senderId], references: [id])
  senderId String

  senderName String  // denormalized for quick display
  body       String
  imageUrl   String? // optional photo attachment (Supabase Storage URL)

  createdAt DateTime @default(now())

  @@index([transportJobId, createdAt])
  @@index([orderId, createdAt])
  @@map("chat_messages")
}

/** Tracks the last time a user read a specific chat room (job or order). */
model ChatLastRead {
  id             String    @id @default(cuid())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String

  transportJobId String?
  orderId        String?

  lastReadAt     DateTime  @default(now())

  @@unique([userId, transportJobId])
  @@unique([userId, orderId])
  @@index([userId])
  @@map("chat_last_reads")
}

// ── Framework Contracts (blanket agreements / call-off orders) ────────────────

model FrameworkContract {
  id             String @id @default(cuid())
  contractNumber String @unique
  title          String

  buyer       Company @relation("BuyerFrameworkContracts", fields: [buyerId], references: [id])
  buyerId     String
  createdBy   User    @relation(fields: [createdById], references: [id])
  createdById String

  supplier   Company? @relation("SupplierFrameworkContracts", fields: [supplierId], references: [id])
  supplierId String?

  status    FrameworkContractStatus @default(DRAFT)
  startDate DateTime
  endDate   DateTime?
  notes     String?

  // B3 Fields — site access contract
  isFieldContract Boolean @default(false)  // true = waste disposal / site entry agreement
  prepaidBalance  Float   @default(0)      // total advance payments received (EUR)
  prepaidUsed     Float   @default(0)      // consumed by issued field passes (EUR)

  project     Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?

  positions   FrameworkPosition[]
  callOffJobs TransportJob[]
  fieldPasses FieldPass[]
  advanceInvoices Invoice[]         @relation("AdvanceInvoices")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("framework_contracts")
}

// ── Projects (construction sites grouping framework contracts) ────────────────

model Project {
  id          String   @id @default(cuid())
  title       String
  address     String?
  lat         Float?
  lng         Float?
  notes       String?

  buyer       Company  @relation(fields: [buyerId], references: [id])
  buyerId     String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdById String

  frameworkContracts FrameworkContract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId])
  @@map("projects")
}

model FrameworkPosition {
  id String @id @default(cuid())

  contract   FrameworkContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId String

  positionType FrameworkPositionType
  description  String
  agreedQty    Float // total agreed quantity
  unit         String                @default("t") // t, m3, loads
  unitPrice    Float?

  pickupAddress   String?
  pickupCity      String?
  deliveryAddress String?
  deliveryCity    String?

  callOffs TransportJob[] @relation("PositionCallOffs")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("framework_positions")
}

// ── Surcharge line items ─────────────────────────────────────────────────────
// Billable levies added to an order after initial placement:
// fuel, waiting time, weekend rates, overweight, toll pass-throughs.
// Each surcharge is a separate signed line item on the order.

model OrderSurcharge {
  id    String @id @default(cuid())

  // Linked to an Order (regular material/freight job) OR a TransportJob (call-off job — no parent order)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String?

  transportJob   TransportJob? @relation("JobSurcharges", fields: [transportJobId], references: [id], onDelete: Cascade)
  transportJobId String?

  type     SurchargeType
  label    String         // Human-readable description shown on invoice
  amount   Float          // EUR; positive = charge to buyer
  currency String         @default("EUR")
  billable Boolean        @default(true) // false = internal cost record only

  // Admin approval — PENDING until reviewed; APPROVED charges proceed to billing; REJECTED are voided
  approvalStatus  String   @default("APPROVED") // 'PENDING' | 'APPROVED' | 'REJECTED'
  approvedByAdminId String?
  approvedAt        DateTime?
  rejectionNote     String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([transportJobId])
  @@index([approvalStatus])
  @@map("order_surcharges")
}

model SavedAddress {
  id    String @id @default(cuid())
  label String          // e.g. "Mājas", "Objekts 14A", "Noliktava"
  address  String        // Full formatted address
  city     String
  lat      Float?
  lng      Float?
  isDefault Boolean     @default(false)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("saved_addresses")
}

/**
 * Saved payment method — stores a tokenised card reference from Paysera.
 * The `payseraToken` is returned by Paysera after a successful payment when
 * recurring-payment consent is enabled on the checkout. It can then be
 * passed back to Paysera to pre-fill or auto-charge on future checkouts.
 *
 * Security: we never store raw card numbers. Only Paysera-issued opaque tokens.
 */
model SavedPaymentMethod {
  id           String  @id @default(cuid())
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String

  label        String          // e.g. "Visa •••• 4242"
  cardType     String          // "VISA" | "MASTERCARD" | "MAESTRO" | "OTHER"
  last4        String          // Last 4 digits of card number (display only)
  expiryMonth  Int             // 1–12
  expiryYear   Int             // full year e.g. 2027
  payseraToken String          // Opaque token returned by Paysera for recurring use
  isDefault    Boolean         @default(false)

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId])
  @@map("saved_payment_methods")
}

// ── Admin audit log ──────────────────────────────────────────────────────────
// Immutable record of every mutating admin action for financial compliance
// and dispute resolution. Never deleted. Retained for minimum 2 years.

model AdminAuditLog {
  id String @id @default(cuid())

  adminId    String // who performed the action
  admin      User   @relation(fields: [adminId], references: [id])

  action     String // e.g. "UPDATE_USER", "APPROVE_APPLICATION", "FORCE_ASSIGN_JOB"
  entityType String // e.g. "User", "Order", "TransportJob", "Company"
  entityId   String // primary key of the affected entity

  before     Json?  // snapshot of relevant fields before mutation
  after      Json?  // snapshot of relevant fields after mutation
  note       String? // optional free-text reason supplied by the admin

  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

// ── Volume price tiers ───────────────────────────────────────────────────────────────────────
// Quantity-break pricing: supplier sets tiers, e.g. ≥0 t = €12, ≥10 t = €10, ≥50 t = €8.
// When an order is placed, the highest matching tier is applied as unitPrice.

model MaterialPriceTier {
  id         String   @id @default(cuid())
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId String

  minQty    Float  // minimum quantity (inclusive) to qualify for this tier
  unitPrice Float  // price per unit at this tier

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([materialId])
  @@map("material_price_tiers")
}

// ── Order schedule (recurring orders) ───────────────────────────────────────────────────
// Stores a template for creating a new Order automatically each period.
// The cron checks nextRunAt daily and clones the template order.

model OrderSchedule {
  id          String  @id @default(cuid())
  createdBy   User    @relation(fields: [createdById], references: [id])
  createdById String

  // The order fields to reproduce each cycle
  orderType       String   // OrderType enum value stored as string
  deliveryAddress String
  deliveryCity    String
  deliveryState   String
  deliveryPostal  String
  deliveryWindow  String?  // e.g. "AM" | "PM" | "ANY"
  deliveryFee     Float    @default(0)
  notes           String?
  siteContactName  String?
  siteContactPhone String?
  itemsSnapshot   Json     // Array of {materialId, quantity, unit}

  // Recurrence
  deliveryLat   Float?
  deliveryLng   Float?

  intervalDays  Int      // 1 = daily, 7 = weekly, 14 = fortnightly, 30 = monthly
  nextRunAt     DateTime // next time the cron will fire a new order
  endsAt        DateTime? // optional end date; null = indefinite
  enabled       Boolean  @default(true)

  // Generated orders
  orders        Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nextRunAt])
  @@index([createdById])
  @@map("order_schedules")
}

// ── Dispute / Claims ─────────────────────────────────────────────────────────

enum DisputeReason {
  SHORT_DELIVERY    // Less material delivered than ordered
  WRONG_MATERIAL    // Wrong material type or grade
  DAMAGE            // Property or site damage
  LATE_DELIVERY     // Delivery significantly later than agreed
  NO_DELIVERY       // Delivery never arrived
  QUALITY_ISSUE     // Material quality did not meet spec
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model Dispute {
  id          String        @id @default(cuid())
  reason      DisputeReason
  description String
  status      DisputeStatus @default(OPEN)
  resolution  String?
  resolvedAt  DateTime?

  order      Order @relation(fields: [orderId], references: [id])
  orderId    String @unique // one active dispute per order

  raisedBy   User   @relation("UserDisputes", fields: [raisedById], references: [id])
  raisedById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([raisedById])
  @@map("disputes")
}

// ── Support Chat ─────────────────────────────────────────────────────────────

model SupportThread {
  id     String @id @default(cuid())
  status String @default("OPEN") // OPEN | CLOSED

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique // one thread per user

  messages SupportMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("support_threads")
}

model SupportMessage {
  id         String @id @default(cuid())
  body       String
  fromAdmin  Boolean @default(false) // false = from user, true = admin reply

  thread   SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId String

  sender   User   @relation(fields: [senderId], references: [id])
  senderId String

  senderName String // denormalized for quick display

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
  @@map("support_messages")
}

// ── API Key (ERP / machine-to-machine) ───────────────────────────────────────
// Keys use the prefix "b3_live_" + 40 random hex chars.
// Only the SHA-256 hash is stored; the plaintext is shown once at creation.

model ApiKey {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  label      String   // Human-readable name ("Jumis sync", "SAP connector")
  keyHash    String   @unique // SHA-256 of the full key (hex)
  keyPrefix  String   // First 12 chars of the full key — shown in management UI

  // Access scopes (whitelist — empty = no access)
  scopes     String[] // e.g. ["orders:read", "invoices:read", "transport:read", "orders:write"]

  lastUsedAt DateTime?
  expiresAt  DateTime? // null = never expires
  revokedAt  DateTime? // null = active

  createdAt  DateTime @default(now())
  createdById String  // User ID who created it

  @@index([companyId])
  @@index([keyHash])
  @@map("api_keys")
}

// ── B3 Fields — Site Access Passes ─────────────────────────────────────────────────────

model FieldPass {
  id         String @id @default(cuid())
  passNumber String @unique // FP-2026-00001, auto-generated

  // Ownership
  company     Company @relation(fields: [companyId], references: [id])
  companyId   String
  createdBy   User    @relation(fields: [createdById], references: [id])
  createdById String

  // Contract link — must be ACTIVE isFieldContract=true
  contract   FrameworkContract @relation(fields: [contractId], references: [id])
  contractId String

  // Vehicle
  vehiclePlate String   // plate number of the truck
  driverName   String?  // optional driver name to print on pass

  // Validity window
  validFrom DateTime
  validTo   DateTime

  // Waste / load details
  wasteClassCode   String? // e.g. 17 05 04 (EWC waste code)
  wasteDescription String? // free-text description
  unloadingPoint   String? // area/zone on site (e.g. "Sekcija A")
  estimatedTonnes  Float?  // expected load weight

  // Status & document
  status  FieldPassStatus @default(ACTIVE)
  fileUrl String?          // generated PDF stored in Supabase

  // Optional link to a B3Hub order (if material purchase triggered the pass)
  order   Order?  @relation(fields: [orderId], references: [id])
  orderId String?

  revokedReason String?
  revokedAt     DateTime?

  // Actual weight recorded by gate operator after vehicle weighing
  actualNetTonnes Float?

  weighingSlips WeighingSlip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([contractId])
  @@index([status])
  @@index([validFrom, validTo])
  @@map("field_passes")
}

// ── B3 Fields — Weighing Slips (gate records) ───────────────────────────────

model WeighingSlip {
  id         String @id @default(cuid())
  slipNumber String @unique // WS-YYYY-NNNNN

  fieldPass   FieldPass @relation(fields: [fieldPassId], references: [id])
  fieldPassId String

  // Weight in tonnes (recorded by gate operator at weigh bridge)
  grossTonnes Float  // incoming gross weight
  tareTonnes  Float  // tare (empty vehicle) weight
  netTonnes   Float  // actual waste/material — gross - tare

  vehiclePlate String  // may differ from pass if substituted
  operatorName String? // gate operator who entered the data

  notes   String?
  fileUrl String? // optional weighing slip PDF

  // Where the weighing was performed — supports dual-weighing (source vs destination)
  weighingPoint WeighingPoint @default(LOADING)

  voidedAt     DateTime? // set when this slip is invalidated
  voidedReason String?

  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([fieldPassId])
  @@index([slipNumber])
  @@map("weighing_slips")
}

enum WeighingPoint {
  LOADING   // Svēršana pie piegādātāja (karjers / avots)
  UNLOADING // Svēršana pie saņēmēja (būvlaukums / galamērķis)
}

// ── B3 Fields — Fulfillment type ─────────────────────────────────────────────
enum OrderFulfillmentType {
  DELIVERY // Standard delivery to buyer's site address
  PICKUP   // Self-collect at a B3 Field physical location
}

// ── B3 Fields — Services offered at a physical location ──────────────────────
enum B3FieldService {
  MATERIAL_PICKUP  // Self-collect materials
  WASTE_DISPOSAL   // Bring your own waste
  TRAILER_RENTAL   // Rent a trailer
}

// ── B3 Fields — Physical fulfillment locations ───────────────────────────────
model B3Field {
  id   String @id @default(cuid())
  name String // e.g. "B3 Field Gulbene"
  slug String @unique // e.g. "gulbene" — used in URLs

  // Location
  address    String
  city       String
  postalCode String
  lat        Float
  lng        Float

  // Services available at this location
  services B3FieldService[]

  // Opening hours — { monday: { open: "07:00", close: "19:00" }, ... null = closed }
  openingHours Json

  // Optional link to a RecyclingCenter (same physical site)
  recyclingCenter   RecyclingCenter? @relation(fields: [recyclingCenterId], references: [id])
  recyclingCenterId String?          @unique

  // Operational
  active Boolean @default(true)
  notes  String? // internal notes for gate operators

  // Relations
  orders         Order[]
  pickupSlots    PickupSlot[]
  inventoryItems B3FieldInventoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@map("b3_fields")
}

// ── Platform Settings — global key/value config store ────────────────────────
model PlatformSetting {
  key       String   @id            // e.g. "jumis.apiUrl", "bis.enabled"
  value     String                  // always stored as string; booleans use "true"/"false"
  updatedAt DateTime @updatedAt
  updatedBy String?                 // admin userId who last changed this

  @@map("platform_settings")
}

// ── B3 Fields — Inventory items (materials in stock at this location) ─────────
model B3FieldInventoryItem {
  id      String  @id @default(cuid())
  field   B3Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  fieldId String

  name         String  // e.g. "Grants 0-32mm", "Smilts smalka"
  unit         String  // e.g. "t", "m³", "gab."
  pricePerUnit Float   // EUR per unit
  stockQty     Float   @default(0)  // current quantity in stock
  minStockQty  Float   @default(0)  // low-stock alert threshold
  available    Boolean @default(true)
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fieldId])
  @@map("b3_field_inventory_items")
}

// ── B3 Fields — Pickup time slots ────────────────────────────────────────────
model PickupSlot {
  id      String @id @default(cuid())
  field   B3Field @relation(fields: [fieldId], references: [id])
  fieldId String

  slotStart  DateTime
  slotEnd    DateTime
  capacity   Int @default(4)  // max vehicles per slot
  booked     Int @default(0)  // current bookings

  // Orders booked into this slot
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fieldId, slotStart])
  @@map("pickup_slots")
}

// ─── Fleet: Cross-BU Vehicle Assignments ─────────────────────────────────────

model VehicleAssignment {
  id          String         @id @default(cuid())
  vehicle     Vehicle        @relation(fields: [vehicleId], references: [id])
  vehicleId   String

  jobType     VehicleJobType
  jobId       String          // polymorphic ref — orderId / constructionJobId / recyclingJobId
  buContext   BuContext

  driverName  String?         // free-text until full User relation is needed
  description String?         // task label shown in fleet overview
  startedAt   DateTime
  endedAt     DateTime?

  notes       String?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([vehicleId])
  @@index([jobType, jobId])
  @@index([buContext])
  @@index([endedAt])
  @@map("vehicle_assignments")
}

enum VehicleJobType {
  ORDER
  DPR
  RECYCLING_JOB
}

enum BuContext {
  CONSTRUCTION
  MARKETPLACE
  RECYCLING
  UNASSIGNED
}

// ─────────────────────────────────────────────────────────────────────────────
// PLATFORM CATALOGUE — admin-managed taxonomies for all service types
// mobile/web reads via GET /api/v1/catalogue/<type>. No code changes needed
// to add or rename a category.
// ─────────────────────────────────────────────────────────────────────────────

/// Buyer-facing transport service categories (what the wizard shows).
/// Maps to one or more VehicleType enum values via eligibleVehicleTypes (JSON array).
/// Admin can add new categories, adjust pricing hints, toggle active — no migration needed.
model VehicleServiceCategory {
  id          String  @id @default(cuid())
  /// Internal code used in orders and matching logic — matches VEHICLE_OPTIONS keys
  code        String  @unique
  label       String
  labelLv     String?
  description String?
  descriptionLv String?
  /// JSON array of VehicleType enum values eligible for this category (e.g. ["DUMP_TRUCK"])
  eligibleVehicleTypes Json   @default("[]")
  /// Minimum load capacity in tonnes (inclusive) — used for dispatch matching
  minCapacityT         Float?
  /// Maximum load capacity in tonnes (inclusive) — used for dispatch matching
  maxCapacityT         Float?
  /// Suggested base price shown in wizard
  fromPrice            Float?
  /// Suggested per-km rate shown in wizard
  pricePerKm           Float?
  /// Key passed to TruckIllustration component
  iconKey              String?
  isActive             Boolean @default(true)
  sortOrder            Int     @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([isActive])
  @@map("vehicle_service_categories")
}

/// Admin-managed rental service type definitions.
/// Replaces hardcoded RENTAL_SERVICES registry in mobile for display/pricing.
/// The RentalServiceType enum on orders stays as the DB-level discriminator.
model RentalServiceDefinition {
  id            String  @id @default(cuid())
  /// Must match RentalServiceType enum value
  code          String  @unique
  label         String
  labelLv       String?
  description   String?
  descriptionLv String?
  /// Grouping for UI sections: "SITE_WELFARE" | "CONSTRUCTION_EQUIPMENT" | "UTILITIES"
  group         String?
  basePrice     Float?
  /// Pricing unit: "day" | "week" | "month"
  priceUnit     String?
  currency      String  @default("EUR")
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, group])
  @@map("rental_service_definitions")
}

/// Admin-managed scrap material definitions for the buyback wizard.
/// Allows adding new buyback streams (copper, aluminium, etc.) without code changes.
model ScrapMaterialDefinition {
  id              String  @id @default(cuid())
  code            String  @unique  // e.g. "FERROUS_METAL", "ALUMINIUM", "COPPER"
  label           String
  labelLv         String?
  description     String?
  descriptionLv   String?
  /// Indicative buyback price per tonne shown to buyers (admin sets from market rate)
  indicativePricePerTonne Float?
  currency        String  @default("EUR")
  /// Whether buyers can self-transport or platform always arranges pickup
  selfTransportAllowed Boolean @default(true)
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
  @@map("scrap_material_definitions")
}

/// Admin-managed catalogue entry for each MaterialCategory enum value.
/// Enriches the static enum with LV labels, descriptions, density, default unit, icon key,
/// and sortOrder — all editable via admin UI without a code deploy.
model MaterialCategoryDefinition {
  id            String  @id @default(cuid())
  /// Must match MaterialCategory enum value exactly
  code          String  @unique
  label         String
  labelLv       String?
  description   String?
  descriptionLv String?
  /// Bulk density in t/m³ — used for volume ↔ weight conversion in wizards
  densityTM3    Float?
  /// Default ordering unit: "TONNE" | "M3" | "PIECE" | "LOAD"
  defaultUnit   String  @default("TONNE")
  /// Key for the category icon component or emoji
  iconKey       String?
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  fractions MaterialFractionDefinition[]

  @@index([isActive])
  @@map("material_category_definitions")
}

/// Admin-managed fraction / grade options per material category.
/// These are shown in the order wizard as a picker (replacing the hardcoded CATEGORY_FRACTIONS).
/// Follows EU aggregate standards (EN 12620, EN 13043, EN 13242) for Latvian construction.
model MaterialFractionDefinition {
  id            String  @id @default(cuid())
  /// Stable code used in Material.fraction — e.g. "GRAVEL_4_8" or "CONCRETE_C25_30"
  code          String  @unique
  /// MaterialCategory enum value this fraction belongs to
  category      String
  /// Display label shown in wizard pickers — e.g. "4–8 mm" or "C25/30"
  label         String
  labelLv       String?
  /// Optional extra context — e.g. "Smalks grants, drenāžai"
  description   String?
  descriptionLv String?
  /// Unit this fraction is typically sold in: "TONNE" | "M3"
  unit          String?
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categoryDef MaterialCategoryDefinition? @relation(fields: [category], references: [code])

  @@index([category, isActive])
  @@map("material_fraction_definitions")
}

// ── PLATFORM CATALOGUE: Waste types ───────────────────────────────────────────
// Admin-managed labels, grouping, and flags for each WasteType enum value.
// Enriches the WasteType enum without requiring a migration to rename/reorder.

model WasteTypeDefinition {
  id            String   @id @default(cuid())
  code          String   @unique   // matches WasteType enum value exactly
  label         String
  labelLv       String?
  description   String?
  descriptionLv String?
  /// Group code: CONSTRUCTION_WASTE | LICENSED_WASTE | SECONDARY_MATERIALS
  group         String   @default("CONSTRUCTION_WASTE")
  groupLabelLv  String?            // display label for the group heading
  isHazardous   Boolean  @default(false)  // routes to licensed partner recyclers
  isBuyback     Boolean  @default(false)  // may have a buyback price (secondary materials)
  iconKey       String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, group])
  @@map("waste_type_definitions")
}

// ─── Native CMS ───────────────────────────────────────────────────────────────

model CmsArticle {
  id               String            @id @default(cuid())
  title            String
  slug             String            @unique
  body             String            // markdown
  excerpt          String?
  type             CmsArticleType    @default(HELP)
  status           CmsStatus         @default(DRAFT)
  locale           String            @default("lv") // lv | en | ru
  translationKey   String?           // groups lv/en/ru variants of same content
  pageKey          String?           // marketing page slot: home | about | services | blog | faq | privacy | terms
  targetRole       String?           // BUYER | SELLER | DRIVER | null = all
  sortOrder        Int               @default(0)
  authorId         String?           // admin user id
  publishedAt      DateTime?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([type])
  @@index([status])
  @@index([locale])
  @@index([translationKey])
  @@index([pageKey])
  @@map("cms_articles")
}

model CmsAnnouncement {
  id          String                  @id @default(cuid())
  title       String
  body        String
  severity    AnnouncementSeverity    @default(INFO)
  target      AnnouncementTarget      @default(ALL)
  visibleFrom DateTime               @default(now())
  visibleUntil DateTime?
  authorId    String?
  active      Boolean                 @default(true)

  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([active])
  @@index([target])
  @@index([visibleUntil])
  @@map("cms_announcements")
}

enum CmsArticleType {
  HELP
  FAQ
  BLOG
  POLICY
  PAGE     // static marketing page content
  LANDING  // landing section block
}

enum CmsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AnnouncementSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AnnouncementTarget {
  ALL
  BUYER
  SELLER
  DRIVER
  ADMIN
}

// ── Fuel Price ────────────────────────────────────────────────────────────────
// Weekly snapshot of Latvia retail diesel price (EUR/L incl. tax).
// Populated by FuelService cron via Eurostat API every Monday 07:00.
model FuelPrice {
  id            String   @id @default(cuid())
  date          DateTime @db.Date   // week start date
  pricePerLitre Float               // EUR per litre, incl. all taxes
  source        String              // "eurostat" | "manual" | "seed"
  country       String   @default("LV")

  createdAt DateTime @default(now())

  @@index([date])
  @@map("fuel_prices")
}

// ── Supplier Loading Slots ────────────────────────────────────────────────────
// Supplier defines repeating weekly loading windows; dispatcher books a slot
// per transport job. Prevents multiple trucks queuing at the loading bay.
model SupplierLoadingSlot {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  dayOfWeek Int     // 0 = Sunday … 6 = Saturday
  startTime String  // "08:00"
  endTime   String  // "10:00"
  capacity  Int     @default(1) // simultaneous truck slots per window
  isActive  Boolean @default(true)
  label     String? // optional display name e.g. "Morning pit window"

  bookings  TransportJob[] @relation("JobLoadingSlot")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, dayOfWeek])
  @@map("supplier_loading_slots")
}
